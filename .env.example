# Copy to .env.local and fill in. Never commit real values.
# For local Supabase, get these from `npx supabase status` after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; used by `npm run import:questions`.
SUPABASE_SERVICE_ROLE_KEY=

# OAuth providers — these go in supabase/.env (read by the Supabase CLI via supabase/config.toml).
# Redirect URI to register in Google and Discord: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_SECRET=
